# Travis server secrets — never ship to the client
# Neon: use the pooled host (*-pooler.*) in transaction mode. Session-mode
# pool_size is 15; the app opens one client and returns it when idle.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
CURSOR_API_KEY=
# Optional: fill a *blank* agent_binding row on Open session. Never overwrites
# a live SQL bind. Per-seat only — do not use a shared PM alias.
SEED_CURSOR_AGENT_ID_PM=
SEED_CURSOR_AGENT_ID_SA=
SEED_CURSOR_AGENT_ID_ENGINEER=
# Dest Travis (SCP-006). Server only. Empty → dest Travis says “isn't wired”.
OPENAI_API_KEY=

# Travis's box (020). Fly Sprites. Server only. Empty → run_box says not wired.
# Token from https://sprites.dev — after the plant. Name defaults to travis.
SPRITES_TOKEN=
# TRAVIS_SPRITE_NAME=travis

# Unfold (021). Server only. Empty → unfold_repo says not wired. Not GITHUB_TOKEN.
TRAVIS_GITHUB_TOKEN=

# Allowlisted operator emails (comma-separated). No signup; these emails request
# a durable personal `/enter/:token` magic link. Used by Hotfix 053.
TRAVIS_OPERATOR_EMAIL=

# Optional: keep local/dev tests working with a known inbox.
TEST_EMAIL_TO=

# Resend — required in production for magic-link mail. Copy from Tower if shared.
RESEND_API_KEY=
# Optional From override (must be a verified Resend domain):
# TRAVIS_FROM_EMAIL=Travis <noreply@mail.try-tower.com>
# RESEND_FROM_EMAIL=
# MAIL_ROOT_DOMAIN=mail.try-tower.com
