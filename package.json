{
  "name": "travis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test src/lib/*.test.ts src/server/db/*.test.ts src/runtime/*.test.ts",
    "test:runtime": "tsx src/runtime/run.ts",
    "test:runtime:prepare": "tsx src/runtime/prepare-browser.ts",
    "test:runtime:pipe": "tsx --test --test-concurrency=1 src/runtime/walks/*.spec.ts",
    "test:runtime:browser": "tsx --test --test-concurrency=1 src/runtime/browser/*.spec.ts",
    "db:push": "tsx --env-file=.env.local src/server/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.local src/server/db/seed.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@cursor/sdk": "^1.0.4",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.11",
    "antd": "^6.6.1",
    "deepagents": "^1.13.3",
    "drizzle-orm": "^0.44.5",
    "langchain": "^1.5.10",
    "lucide-react": "^1.34.0",
    "next": "^15.5.2",
    "pg": "^8.23.0",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.17.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
